{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-debug-asan",
      "displayName": "Linux Debug ASAN",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NANOSIG_ENABLE_ASAN": "ON",
        "NANOSIG_ENABLE_TSAN": "OFF",
        "NANOSIG_ENABLE_UBSAN": "OFF"
      }
    },
    {
      "name": "linux-debug-tsan",
