{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NANOSIG_PLATFORM": "host",
        "NANOSIG_BUILD_FREERTOS_POSIX": "OFF",
        "NANOSIG_ENABLE_ASAN": "OFF",
        "NANOSIG_ENABLE_TSAN": "OFF",
        "NANOSIG_ENABLE_UBSAN": "OFF",
        "NANOSIG_ENABLE_COVERAGE": "OFF"
      }
    },
    {
      "name": "_linux",
      "hidden": true,
      "inherits": "_base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "_macos",
      "hidden": true,
      "inherits": "_base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "_windows",
      "hidden": true,
      "inherits": "_base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja"
    },
    {
      "name": "_freertos",
      "hidden": true,
      "inherits": "_base",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "cacheVariables": {
        "NANOSIG_PLATFORM": "freertos",
        "NANOSIG_BUILD_FREERTOS_POSIX": "ON"
      }
    },
    {
      "name": "_baremetal",
      "hidden": true,
      "inherits": "_base",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": ["Linux", "Darwin"]
      },
      "cacheVariables": {
        "NANOSIG_PLATFORM": "baremetal",
        "NANOSIG_BUILD_DEMOS": "OFF",
        "NANOSIG_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "linux-debug-asan",
      "displayName": "Linux Debug ASAN",
      "inherits": "_linux",
      "cacheVariables": {
        "NANOSIG_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "linux-debug-tsan",
      "displayName": "Linux Debug TSAN",
      "inherits": "_linux",
      "cacheVariables": {
        "NANOSIG_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "linux-debug-ubsan",
      "displayName": "Linux Debug UBSAN",
      "inherits": "_linux",
      "cacheVariables": {
        "NANOSIG_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux Coverage (gcov/lcov)",
      "inherits": "_linux",
      "cacheVariables": {
        "NANOSIG_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "macos-debug-asan",
      "displayName": "macOS Debug ASAN",
      "inherits": "_macos",
      "cacheVariables": {
        "NANOSIG_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "macos-debug-ubsan",
      "displayName": "macOS Debug UBSAN",
      "inherits": "_macos",
      "cacheVariables": {
        "NANOSIG_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": "_macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-debug-asan",
      "displayName": "Windows Debug ASAN",
      "inherits": "_windows",
      "cacheVariables": {
        "NANOSIG_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": "_windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "freertos-release",
      "displayName": "FreeRTOS POSIX harness (Release)",
      "inherits": "_freertos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "freertos-debug-asan",
      "displayName": "FreeRTOS POSIX harness (Debug ASAN)",
      "inherits": "_freertos",
      "cacheVariables": {
        "NANOSIG_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "freertos-debug-ubsan",
      "displayName": "FreeRTOS POSIX harness (Debug UBSAN)",
      "inherits": "_freertos",
      "cacheVariables": {
        "NANOSIG_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "baremetal-debug",
      "displayName": "Baremetal backend (Debug, host harness)",
      "inherits": "_baremetal",
      "binaryDir": "${sourceDir}/build-baremetal-debug"
    },
    {
      "name": "baremetal-debug-asan",
      "displayName": "Baremetal backend (Debug ASAN, host harness)",
      "inherits": "_baremetal",
      "binaryDir": "${sourceDir}/build-baremetal-debug-asan",
      "cacheVariables": {
        "NANOSIG_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "baremetal-debug-ubsan",
      "displayName": "Baremetal backend (Debug UBSAN, host harness)",
      "inherits": "_baremetal",
      "binaryDir": "${sourceDir}/build-baremetal-debug-ubsan",
      "cacheVariables": {
        "NANOSIG_ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug-asan", "configurePreset": "linux-debug-asan" },
    { "name": "linux-debug-tsan", "configurePreset": "linux-debug-tsan" },
    { "name": "linux-debug-ubsan", "configurePreset": "linux-debug-ubsan" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" },
    { "name": "macos-debug-asan", "configurePreset": "macos-debug-asan" },
    { "name": "macos-debug-ubsan", "configurePreset": "macos-debug-ubsan" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "windows-debug-asan", "configurePreset": "windows-debug-asan" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "freertos-release", "configurePreset": "freertos-release" },
    { "name": "freertos-debug-asan", "configurePreset": "freertos-debug-asan" },
    { "name": "freertos-debug-ubsan", "configurePreset": "freertos-debug-ubsan" },
    { "name": "baremetal-debug", "configurePreset": "baremetal-debug" },
    { "name": "baremetal-debug-asan", "configurePreset": "baremetal-debug-asan" },
    { "name": "baremetal-debug-ubsan", "configurePreset": "baremetal-debug-ubsan" }
  ],
  "testPresets": [
    { "name": "_output", "hidden": true, "output": {"outputOnFailure": true} },
    { "name": "linux-debug-asan", "configurePreset": "linux-debug-asan", "inherits": "_output" },
    { "name": "linux-debug-tsan", "configurePreset": "linux-debug-tsan", "inherits": "_output" },
    { "name": "linux-debug-ubsan", "configurePreset": "linux-debug-ubsan", "inherits": "_output" },
    { "name": "linux-release", "configurePreset": "linux-release", "inherits": "_output" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage", "inherits": "_output" },
    { "name": "macos-debug-asan", "configurePreset": "macos-debug-asan", "inherits": "_output" },
    { "name": "macos-debug-ubsan", "configurePreset": "macos-debug-ubsan", "inherits": "_output" },
    { "name": "macos-release", "configurePreset": "macos-release", "inherits": "_output" },
    { "name": "windows-debug-asan", "configurePreset": "windows-debug-asan", "inherits": "_output" },
    { "name": "windows-release", "configurePreset": "windows-release", "inherits": "_output" },
    { "name": "freertos-release", "configurePreset": "freertos-release", "inherits": "_output" },
    { "name": "freertos-debug-asan", "configurePreset": "freertos-debug-asan", "inherits": "_output" },
    { "name": "freertos-debug-ubsan", "configurePreset": "freertos-debug-ubsan", "inherits": "_output" },
    { "name": "baremetal-debug", "configurePreset": "baremetal-debug", "inherits": "_output" },
    { "name": "baremetal-debug-asan", "configurePreset": "baremetal-debug-asan", "inherits": "_output" },
    { "name": "baremetal-debug-ubsan", "configurePreset": "baremetal-debug-ubsan", "inherits": "_output" }
  ]
}
