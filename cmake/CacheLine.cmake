include_guard(GLOBAL)

set(NS_MPSC_CACHELINE_SIZE "" CACHE STRING
    "MPSC cache-line spacing in bytes (power of two >= 16); empty probes native hardware")

function(_nanosig_cacheline_is_valid value result)
    set(_valid FALSE)
    string(LENGTH "${value}" _length)
    if("${value}" MATCHES "^[1-9][0-9]*$" AND _length LESS_EQUAL 19)
        if(_length LESS 19 OR NOT "${value}" STRGREATER "9223372036854775807")
            math(EXPR _remainder "${value} & (${value} - 1)")
            if(value GREATER_EQUAL 16 AND _remainder EQUAL 0)
                set(_valid TRUE)
            endif()
        endif()
    endif()
    set(${result} "${_valid}" PARENT_SCOPE)
endfunction()

function(nanosig_apply_cacheline target)
    if(NOT "${NS_MPSC_CACHELINE_SIZE}" STREQUAL "")
        _nanosig_cacheline_is_valid("${NS_MPSC_CACHELINE_SIZE}" _valid)
        if(NOT _valid)
            message(FATAL_ERROR "NS_MPSC_CACHELINE_SIZE must be a decimal power of two >= 16 that fits a signed 64-bit integer")
        endif()
        set(_size "${NS_MPSC_CACHELINE_SIZE}")
        set(_reason "explicit configuration")
    else()
        set(_native TRUE)
        if(CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME STREQUAL CMAKE_HOST_SYSTEM_NAME)
            set(_native FALSE)
        endif()
        string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _target_arch)
        string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" _host_arch)
        string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" _generator_arch)
        string(REGEX REPLACE ",.*$" "" _generator_arch "${_generator_arch}")
        string(REGEX REPLACE "-.*$" "" _compiler_arch "${CMAKE_C_COMPILER_TARGET}")
        string(TOLOWER "${_compiler_arch}" _compiler_arch)
        foreach(_arch _target_arch _host_arch _generator_arch _compiler_arch)
            string(REGEX REPLACE "^(amd64|x64)$" "x86_64" ${_arch} "${${_arch}}")
            string(REGEX REPLACE "^(win32|i[3-6]86)$" "x86" ${_arch} "${${_arch}}")
            string(REGEX REPLACE "^aarch64$" "arm64" ${_arch} "${${_arch}}")
        endforeach()
        if(NOT _target_arch STREQUAL _host_arch)
            set(_native FALSE)
        endif()
        foreach(_arch _generator_arch _compiler_arch)
            if(NOT "${${_arch}}" STREQUAL "" AND NOT "${${_arch}}" STREQUAL "${_host_arch}")
                set(_native FALSE)
            endif()
        endforeach()
        # Apple SDK/architecture selection can cross targets without setting CMAKE_CROSSCOMPILING.
        foreach(_arch IN LISTS CMAKE_OSX_ARCHITECTURES)
            if(NOT _arch STREQUAL _host_arch)
                set(_native FALSE)
            endif()
        endforeach()
        if(APPLE AND CMAKE_OSX_SYSROOT)
            string(TOLOWER "${CMAKE_OSX_SYSROOT}" _sdk)
            if(NOT _sdk MATCHES "(^|/)macosx([^/]*\\.sdk)?$")
                set(_native FALSE)
            endif()
        endif()

        set(_size 64)
        set(_reason "fallback; set NS_MPSC_CACHELINE_SIZE for the target CPU")
        if(_native)
            unset(_nanosig_cacheline_run CACHE)
            unset(_nanosig_cacheline_compiled CACHE)
            try_run(_nanosig_cacheline_run _nanosig_cacheline_compiled
                "${PROJECT_BINARY_DIR}/CMakeFiles/nanosig-cacheline"
                "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../platform/cache_line_probe.c"
                C_STANDARD 11
                RUN_OUTPUT_VARIABLE _output)
            string(STRIP "${_output}" _detected)
            _nanosig_cacheline_is_valid("${_detected}" _valid)
            if(_nanosig_cacheline_compiled AND "${_nanosig_cacheline_run}" STREQUAL "0" AND _valid)
                set(_size "${_detected}")
                set(_reason "native hardware probe")
            endif()
            unset(_nanosig_cacheline_run CACHE)
            unset(_nanosig_cacheline_compiled CACHE)
        endif()
    endif()
    message(STATUS "MPSC cache-line spacing: ${_size} bytes (${_reason})")
    target_compile_definitions(${target} PUBLIC "NS_MPSC_CACHELINE_SIZE=${_size}")
endfunction()
